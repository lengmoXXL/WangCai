{
  "name": "wangcai-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "旺财 — persistent terminals, local and remote",
  "main": "dist/main/index.js",
  "dependencies": {
    "@wangcai/sdk": "file:../sdk"
  },
  "build": {
    "appId": "dev.wangcai.desktop",
    "productName": "旺财",
    "icon": "build/icon.png",
    "artifactName": "wangcai-${version}-${arch}.${ext}",
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/ui/**/*"
    ],
    "extraResources": [
      {
        "from": "../wangcaicli/dist/release/wangcai",
        "to": "wangcai"
      },
      {
        "from": "dist/plugins",
        "to": "plugins"
      },
      {
        "from": "node",
        "to": "node"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false
    },
    "directories": {
      "output": "dist/package"
    }
  },
  "scripts": {
    "dev": "node tools/fetch-node.mjs && node tools/build-plugins.mjs && electron-vite dev",
    "build": "node tools/fetch-node.mjs && node tools/build-plugins.mjs && electron-vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --mac dir",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "41.10.7",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
