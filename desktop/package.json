{
  "name": "shu-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "shū — persistent terminals, local and remote",
  "main": "out/main/index.js",
  "dependencies": {
    "@shu/sdk": "file:../sdk",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "dev.shu.desktop",
    "productName": "shu",
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../target/release/shu",
        "to": "shu"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "CFBundleDisplayName": "shū"
      }
    },
    "asarUnpack": [
      "node_modules/esbuild/**/*",
      "node_modules/@esbuild/**/*"
    ],
    "directories": {
      "output": "../dist"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --mac dir",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "41.10.7",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
