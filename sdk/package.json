{
  "name": "@lengmoxxl/sdk",
  "version": "0.1.2",
  "description": "Client SDK for WangCai: connect to a local or remote machine and drive its pty, files and git",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lengmoXXL/WangCai.git",
    "directory": "sdk"
  },
  "keywords": [
    "wangcai",
    "pty",
    "ssh",
    "terminal",
    "sdk"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs"
    },
    "./channel": {
      "types": "./dist/channel.d.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "esbuild index.ts --outfile=dist/index.cjs --bundle --platform=node --target=node22 --packages=external && tsc",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.9.0",
    "esbuild": "^0.25.0"
  }
}
