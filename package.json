{
  "name": "shu-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "shū — persistent terminals, local and remote",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "cargo build && npm run build:sdk && electron-vite dev",
    "build": "cargo build && npm run build:sdk && tsc --noEmit && electron-vite build",
    "start": "electron .",
    "test": "cargo build && npm run build:sdk && tsc --noEmit && electron-vite build && node --test tests/*.test.cjs",
    "package": "cargo build --release && npm run build:sdk && tsc --noEmit && electron-vite build && electron-builder --mac dir",
    "build:sdk": "node scripts/build-sdk.mjs && tsc -p sdk/tsconfig.json",
    "install:terminal": "node scripts/install-terminal.mjs",
    "typecheck": "tsc --noEmit",
    "test:package": "npm run package && node --test tests/package.cjs"
  },
  "dependencies": {
    "@shu/sdk": "file:sdk",
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@xterm/headless": "^6.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "dev.shu.desktop",
    "productName": "shu",
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "target/release/shu",
        "to": "shu"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "CFBundleDisplayName": "shū"
      }
    },
    "asarUnpack": [
      "node_modules/esbuild/**/*",
      "node_modules/@esbuild/**/*"
    ]
  },
  "workspaces": [
    "sdk"
  ]
}
